{"nodes": [{"id": "_agents_skills_material_3_skill", "label": "Material 3 Skill", "file_type": "document", "source_file": ".agents/skills/material-3/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_material_3_skill_md3_principles", "label": "MD3 Principles (Personal, Adaptive, Expressive)", "file_type": "rationale", "source_file": ".agents/skills/material-3/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MD3 aims to be personal (dynamic color), adaptive (5 window size classes) and expressive (shape morphing, springs, emphasized type) without sacrificing usability."}, {"id": "_agents_skills_material_3_skill_compose_first_android", "label": "Compose-first Material Android (I/O 2026)", "file_type": "rationale", "source_file": ".agents/skills/material-3/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New Android Material 3 work should default to Jetpack Compose Material3 for latest components, expressive APIs and adaptive scaffolds; Views only for legacy apps."}, {"id": "_agents_skills_material_3_skill_m3_expressive", "label": "M3 Expressive Update (May 2025)", "file_type": "concept", "source_file": ".agents/skills/material-3/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds visual richness (springs, shape morphing, emphasized type, new button sizes, contrast levels); availability differs by platform, Compose-first."}, {"id": "_agents_skills_material_3_skill_md_sys_design_tokens", "label": "md.sys Design Token System", "file_type": "concept", "source_file": ".agents/skills/material-3/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_material_3_skill_material_web_maintenance_mode", "label": "@material/web (maintenance mode)", "file_type": "concept", "source_file": ".agents/skills/material-3/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Material Web is maintenance-only and does not implement M3 Expressive, so it is not equivalent to Compose for current features."}, {"id": "_agents_skills_material_3_skill_md2_vs_md3_differences", "label": "Key Differences from MD2", "file_type": "rationale", "source_file": ".agents/skills/material-3/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tonal surfaces replace shadows, dynamic color from one seed, fully rounded corners, spring motion, and 3 contrast levels."}, {"id": "_agents_skills_material_3_skill_md3_anti_patterns", "label": "MD3 Anti-Patterns", "file_type": "rationale", "source_file": ".agents/skills/material-3/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hardcoded colors/radii break dynamic theming, dark mode and contrast; mixing MD2 and MD3 libs, barrel imports, shadow-by-default and phone-only layouts are prohibited."}, {"id": "_agents_skills_material_3_skill_md3_compliance_audit", "label": "MD3 Compliance Audit (10 categories, 0-10 scoring)", "file_type": "concept", "source_file": ".agents/skills/material-3/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_material_3_skill_app_shell_pattern", "label": "App Shell Pattern", "file_type": "concept", "source_file": ".agents/skills/material-3/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_material_3_skill_component_name_mapping", "label": "Component Name Mapping (Web/Flutter/Compose)", "file_type": "concept", "source_file": ".agents/skills/material-3/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_material_3_skill_frontend_design_relationship", "label": "Relationship with frontend-design Skill", "file_type": "rationale", "source_file": ".agents/skills/material-3/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MD3 supplies design system rules and takes precedence; Roboto/Roboto Flex is the correct default so frontend-design's avoid-Roboto rule does not apply."}, {"id": "_agents_skills_material_3_skill_expressive_platform_matrix", "label": "M3 Expressive Platform Availability Matrix", "file_type": "concept", "source_file": ".agents/skills/material-3/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_material_3_skill_materialtheme", "label": "MaterialTheme (Compose)", "file_type": "concept", "source_file": ".agents/skills/material-3/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_material_3_skill_8dp_spacing_system", "label": "8dp Spacing System", "file_type": "concept", "source_file": ".agents/skills/material-3/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spacing tokens for margins, padding and gaps allow layouts to adapt programmatically to device type and density."}, {"id": "_agents_skills_material_3_skill_watches_and_xr_guidance", "label": "Watches and XR Guidance", "file_type": "concept", "source_file": ".agents/skills/material-3/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_agents_skills_material_3_skill", "target": "_agents_skills_material_3_skill_md3_prin